# ---- Endereços dos back-ends ----
# Em desenvolvimento (npm run dev) use as portas padrão abaixo.
# Em produção (Vercel -> Settings -> Environment Variables) coloque as URLs
# dos back-ends publicados, SEM barra no final, e faça um novo deploy.
VITE_API_URL=http://localhost:3002            # contMB  (contas, login, carrinho)
VITE_PRODUTOS_API_URL=http://localhost:3001   # prodMB  (produtos e pedidos)

# ---- Login com Google (opcional) ----
# 1. https://console.cloud.google.com/apis/credentials -> Criar credenciais -> ID do cliente OAuth -> Aplicativo da Web
# 2. Em "Origens JavaScript autorizadas" adicione http://localhost:5173 e o domínio do site
# 3. Cole o ID aqui E também em GOOGLE_CLIENT_ID no .env do contMB (o servidor confere o token)
VITE_GOOGLE_CLIENT_ID=
